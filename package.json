{
	"name": "highlight-bot",
	"version": "3.0.0",
	"description": "An utility bot written in Sapphire to get highlighted when a word, or regular expression is said",
	"private": true,
	"main": "dist/Highlight.js",
	"type": "module",
	"imports": {
		"#generated/*": "./dist/lib/generated/*.js",
		"#internals/*": "./dist/lib/internals/*.js",
		"#hooks/*": "./dist/lib/utils/hooks/*.js",
		"#setup": "./dist/lib/setup.js",
		"#customIds/*": "./dist/lib/structures/customIds/*.js",
		"#structures/*": "./dist/lib/structures/*.js",
		"#types/*": "./dist/lib/types/*.js",
		"#utils/*": "./dist/lib/utils/*.js",
		"#workers/*": "./dist/lib/workers/*.js"
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist",
		"cleanbuild": "pnpm run clean && tsc",
		"coverage": "vitest run --coverage",
		"lint": "oxfmt --check && oxlint src tests",
		"format": "oxfmt && oxlint --fix src tests",
		"generate": "prisma generate --sql",
		"start": "pnpm run cleanbuild && node .",
		"test": "vitest run",
		"watch": "tsc -w"
	},
	"dependencies": {
		"@discordjs/builders": "^1.11.2",
		"@mikro-orm/sql-highlighter": "^1.0.1",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@sapphire/decorators": "^6.1.1",
		"@sapphire/discord-utilities": "^3.5.0",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/framework": "^5.3.4",
		"@sapphire/pieces": "^4.4.1",
		"@sapphire/plugin-logger": "^4.0.2",
		"@sapphire/plugin-subcommands": "^6.0.3",
		"@sapphire/stopwatch": "^1.5.4",
		"@sapphire/time-utilities": "^1.7.14",
		"@sapphire/timestamp": "^1.0.5",
		"@sapphire/utilities": "^3.18.2",
		"@skyra/env-utilities": "^2.0.0",
		"@skyra/jaro-winkler": "^1.1.1",
		"colorette": "^2.0.20",
		"confusables": "^1.1.1",
		"discord-api-types": "^0.38.4",
		"discord.js": "^14.19.3",
		"lru-cache": "^11.1.0",
		"re2": "^1.21.4",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.1",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^3.1.3",
		"eslint": "^10.11.0",
		"eslint-config-neon": "0.5.4",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"prisma": "7.10.0",
		"rimraf": "^6.0.1",
		"typescript": "7.0.2",
		"vitest": "^3.1.3"
	},
	"author": {
		"name": "Vlad Frangu",
		"email": "me@vladfrangu.dev"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.8.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.8.1",
	"volta": {
		"node": "24.21.0",
		"pnpm": "12.8.1"
	}
}
